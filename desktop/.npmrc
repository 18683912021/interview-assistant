# Electron 二进制下载镜像（npmmirror）：
# Electron 43 起 npm 包无 postinstall，二进制在首次 require('electron') 时懒下载；
# 其 @electron/get 的 undici fetch 默认不吃 HTTP(S)_PROXY，本网络下直连 GitHub 必失败。
# 经 pnpm 生命周期脚本启动时以 npm_config_* 形式注入生效；
# 直接 `node scripts/ensure-native.cjs` 调用时由该脚本自身兜底读取。
electron_mirror=https://npmmirror.com/mirrors/electron/
# electron-builder 的辅助二进制（winCodeSign/nsis 等）走另一个仓库，同样指向 npmmirror
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
