{
  "name": "audio-capture",
  "version": "0.5.8",
  "description": "Interview workspace for preparation, live assistance, and review",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.23.1"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/ensure-native.cjs",
    "dev": "concurrently --kill-others-on-fail \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"node scripts/launch-electron.cjs\"",
    "build": "vite build && tsc -p electron/tsconfig.json && node scripts/ensure-native.cjs && electron-builder",
    "ensure:native": "node scripts/ensure-native.cjs",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src/ electron/"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-tooltip": "^1.3.0",
    "eventemitter3": "5.0.1",
    "framer-motion": "11.15.0",
    "lucide-react": "^1.28.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "eslint": "9.16.0",
    "eslint-plugin-react": "7.37.3",
    "eslint-plugin-react-hooks": "5.1.0",
    "jsdom": "^30.1.2",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.19.0",
    "vite": "6.0.5",
    "vitest": "3.0.4"
  }
}
